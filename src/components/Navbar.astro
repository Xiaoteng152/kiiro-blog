---
const navLinks = [
  { href: '/', label: '首页' },
  { href: '/blog', label: '博客' },
  { href: '/projects', label: '项目' },
  { href: '/hobbies', label: '爱好' },
  { href: '/about', label: '关于' },
]

const currentPath = Astro.url.pathname
---

<header style="border-bottom: 1px solid var(--color-border); background-color: color-mix(in srgb, var(--color-bg) 78%, transparent);" class="sticky top-0 z-50 backdrop-blur-md">
  <nav class="max-w-3xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="font-bold text-lg no-underline group inline-flex items-center" style="color: var(--color-text)">
      Kiiro<span class="dot-pulse inline-block" style="color: var(--color-accent)">.</span>
    </a>

    <!-- Nav Links -->
    <ul class="flex items-center gap-6 text-sm font-medium">
      {navLinks.map(link => {
        const active = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
        return (
          <li>
            <a
              href={link.href}
              data-active={active ? 'true' : 'false'}
              class:list={['nav-link no-underline transition-colors duration-200', active ? 'font-semibold' : '']}
              style={active ? 'color: var(--color-accent-strong)' : 'color: var(--color-muted)'}
            >
              {link.label}
            </a>
          </li>
        )
      })}
    </ul>
  </nav>
</header>
