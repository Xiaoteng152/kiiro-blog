---
import PageLayout from '../layouts/PageLayout.astro'

const projects = [
  {
    title: "个人博客",
    description: "基于 Astro + Tailwind CSS + Vercel 搭建的个人博客，支持 Markdown 写作和明暗模式切换。",
    tags: ["Astro", "Tailwind CSS", "Vercel"],
    link: "https://github.com",
    demo: "/",
  },
]
---

<PageLayout title="项目 - kiiro's blog" description="我的开源项目与作品集">
  <div class="pt-6 pb-8" data-reveal>
    <h1 class="text-3xl font-bold mb-2" style="color: var(--color-text)">项目</h1>
    <p style="color: var(--color-muted)">我的开源项目与个人作品</p>
  </div>

  <div class="grid gap-4">
    {projects.map((project, i) => (
      <article class="card p-5 rounded-2xl" data-reveal style={`--reveal-delay:${i * 80}ms`}>
        <div class="flex items-start justify-between gap-4 mb-2">
          <h2 class="font-semibold text-base" style="color: var(--color-text)">{project.title}</h2>
          <div class="flex items-center gap-3 text-sm shrink-0">
            {project.demo && (
              <a href={project.demo} target="_blank" rel="noopener noreferrer" class="link-soft no-underline" style="color: var(--color-accent-strong)">
                预览
              </a>
            )}
            <a href={project.link} target="_blank" rel="noopener noreferrer" class="link-soft no-underline" style="color: var(--color-muted)">
              GitHub →
            </a>
          </div>
        </div>
        <p class="text-sm mb-4" style="color: var(--color-muted)">{project.description}</p>
        <div class="flex flex-wrap gap-1.5">
          {project.tags.map(tag => (
            <span class="px-2 py-0.5 rounded-full text-xs" style="background-color: var(--color-border); color: var(--color-muted)">
              {tag}
            </span>
          ))}
        </div>
      </article>
    ))}
  </div>
</PageLayout>
