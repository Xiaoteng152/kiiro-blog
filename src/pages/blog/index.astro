---
import PageLayout from '../../layouts/PageLayout.astro'
import { getCollection } from 'astro:content'

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

// 收集所有标签
const allTags = [...new Set(allPosts.flatMap(p => p.data.tags))]

const selectedTag = Astro.url.searchParams.get('tag')
const posts = selectedTag
  ? allPosts.filter(p => p.data.tags.includes(selectedTag))
  : allPosts
---

<PageLayout title="博客 - kiiro's blog" description="技术文章、学习笔记与思考">
  <div class="pt-6 pb-4">
    <h1 class="text-3xl font-bold mb-2" style="color: var(--color-text)">博客</h1>
    <p class="text-sm" style="color: var(--color-muted)">共 {allPosts.length} 篇文章</p>
  </div>

  <!-- Tags -->
  {allTags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-8">
      <a
        href="/blog"
        class:list={['px-3 py-1 rounded-full text-xs font-medium no-underline transition-colors', !selectedTag ? 'text-white' : '']}
        style={!selectedTag ? 'background-color: var(--color-accent); color: white' : 'background-color: var(--color-border); color: var(--color-muted)'}
      >
        全部
      </a>
      {allTags.map(tag => (
        <a
          href={`/blog?tag=${tag}`}
          class="px-3 py-1 rounded-full text-xs font-medium no-underline transition-colors"
          style={selectedTag === tag ? 'background-color: var(--color-accent); color: white' : 'background-color: var(--color-border); color: var(--color-muted)'}
        >
          {tag}
        </a>
      ))}
    </div>
  )}

  <!-- Post List -->
  <ul class="space-y-1">
    {posts.map(post => (
      <li>
        <a href={`/blog/${post.id}`} class="group block no-underline">
          <article class="py-5" style="border-bottom: 1px solid var(--color-border)">
            <div class="flex items-start justify-between gap-4 mb-2">
              <h2 class="font-semibold text-base group-hover:opacity-70 transition-opacity" style="color: var(--color-text)">
                {post.data.title}
              </h2>
              <time class="text-xs shrink-0 mt-1" style="color: var(--color-muted)">
                {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>
            <p class="text-sm mb-3 line-clamp-2" style="color: var(--color-muted)">
              {post.data.description}
            </p>
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.map(tag => (
                <span class="px-2 py-0.5 rounded-full text-xs" style="background-color: var(--color-border); color: var(--color-muted)">
                  {tag}
                </span>
              ))}
            </div>
          </article>
        </a>
      </li>
    ))}
  </ul>

  {posts.length === 0 && (
    <div class="text-center py-20" style="color: var(--color-muted)">
      没有找到相关文章
    </div>
  )}
</PageLayout>
