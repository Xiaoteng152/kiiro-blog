---
import PageLayout from '../layouts/PageLayout.astro'
---

<PageLayout title="404 - 页面未找到" description="页面不存在">
  <div class="flex flex-col items-center justify-center py-32 text-center" data-reveal>
    <h1 class="gradient-text text-8xl font-bold mb-4 avatar-float">404</h1>
    <p class="text-xl font-medium mb-2" style="color: var(--color-text)">页面未找到</p>
    <p class="text-sm mb-8" style="color: var(--color-muted)">你访问的页面不存在或已被移动。</p>
    <a href="/" class="btn-primary inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold no-underline">
      回到首页
    </a>
  </div>
</PageLayout>
